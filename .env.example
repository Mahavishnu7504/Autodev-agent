# AutoDev Agent configuration template
# Copy this file to .env and set your own private values.

AUTODEV_HOST=127.0.0.1
AUTODEV_PORT=8000
AUTODEV_USERNAME=admin
AUTODEV_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
AUTODEV_STATE_DIR=/data/tasks

GROQ_API_KEY=YOUR_GROQ_API_KEY
EXECUTOR_MODEL=SET_YOUR_EXECUTOR_MODEL
PLANNER_MODEL=SET_YOUR_PLANNER_MODEL
FIXER_MODEL=SET_YOUR_FIXER_MODEL
